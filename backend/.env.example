# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# ── OpenRouter (cloud fallback when Ollama is unreachable) ───────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Gemini (optional alternative fallback — not wired into llm_service.py
#    by default; see services/gemini_service.py) ─────────────────────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production.
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no extra setup needed)
DATABASE_URL=sqlite:///./krishibot.db

# PostgreSQL example (uncomment and fill in to switch)
# DATABASE_URL=postgresql://user:password@localhost:5432/krishibot

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=True
